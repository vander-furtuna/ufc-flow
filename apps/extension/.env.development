# API do Flow usada pela extensão no desenvolvimento. Entra no manifesto
# (host_permissions) e no login do popup. A URL pública chega com o deploy
# (fase 13).
PLASMO_PUBLIC_FLOW_API_URL=http://localhost:3333

# Login e envio ao Flow (D41). Deixe false até a fase 5 ou ligue para testar o
# login contra a API local.
PLASMO_PUBLIC_FLOW_SYNC=false
