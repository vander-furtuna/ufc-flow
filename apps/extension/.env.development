# API e web do Flow usados pela extensão no desenvolvimento. A URL da API
# entra no manifesto (host_permissions). As URLs públicas chegam com o deploy
# (fase 13).
PLASMO_PUBLIC_FLOW_API_URL=http://localhost:3333
PLASMO_PUBLIC_FLOW_WEB_URL=http://localhost:3000

# Login e envio ao Flow (D41)
PLASMO_PUBLIC_FLOW_SYNC=true
