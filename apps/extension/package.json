{
  "name": "@ufc-flow/extension",
  "displayName": "UFC Flow",
  "version": "0.1.0",
  "description": "Extrai a estrutura curricular do SIGAA para o UFC Flow",
  "author": "Vanderlei Furtuna",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i src/styles/tailwind.css -o src/styles/generated.css",
    "dev": "pnpm vendor && pnpm css && concurrently -k -n css,plasmo \"pnpm css --watch\" \"plasmo dev\"",
    "build": "pnpm vendor && pnpm css --minify && plasmo build",
    "package": "plasmo package",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "vendor": "node scripts/bundle-zod.mjs"
  },
  "dependencies": {
    "@ufc-flow/academic-core": "workspace:*",
    "@ufc-flow/contracts": "workspace:*",
    "lucide-react": "^1.17.0",
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/chrome": "^0.1.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://si3.ufc.br/*",
      "$PLASMO_PUBLIC_FLOW_API_URL/*"
    ]
  },
  "alias": {
    "zod": "./src/vendor/zod.js"
  }
}
