{
  "name": "@ufc-flow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "seed:admin": "tsx --env-file-if-exists=.env src/scripts/seed-admin.ts",
    "openapi": "tsx src/scripts/export-openapi.ts",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "seed:catalog": "tsx --env-file-if-exists=.env src/scripts/seed-catalog.ts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.3.1",
    "testcontainers": "12.2.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@ufc-flow/academic-core": "workspace:*",
    "@ufc-flow/contracts": "workspace:*",
    "cheerio": "^1.2.0",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.14",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  }
}
