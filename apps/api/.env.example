# Copie para apps/api/.env. Valores do docker/compose.dev.yml.
DATABASE_URL=postgres://ufcflow:ufcflow@localhost:5432/ufcflow
# Segredo dos tokens de acesso (32+ caracteres). Gere um: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
PORT=3333
# Base dos links de redefinição de senha
WEB_URL=http://localhost:3000
# Swagger em /docs. Em produção, defina usuário e senha ou desligue.
SWAGGER_ENABLED=true
# SWAGGER_USER=
# SWAGGER_PASSWORD=

# Leitura semanal da lista pública de cursos do SIGAA (segunda, 4h)
SIGAA_SYNC_ENABLED=true
