{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "PLASMO_PUBLIC_*",
        "API_URL",
        "PRIVACY_CONTACT_EMAIL",
        "BETA_FEEDBACK_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["API_URL", "PRIVACY_CONTACT_EMAIL", "BETA_FEEDBACK_URL"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "test:integration": {
      "cache": false
    }
  }
}
